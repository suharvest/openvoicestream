{
  "name": "jetson-edgellm-v091-customvoice",
  "description": "TensorRT-Edge-LLM v0.9.1 Qwen3-ASR b2 plus Qwen3-TTS CustomVoice. All runtime binaries and engines come from /opt/edgellm-v091; v080/v090 profiles remain rollback-only.",
  "asr_backend": "jetson.trt_edge_llm",
  "tts_backend": "jetson.trt_edge_llm",
  "tts_model_id": "qwen3-tts-customvoice",
  "artifact_set": "edgellm-v091",
  "execution_policy": {"mode": "exclusive", "shared_resource": "gpu"},
  "env": {
    "LANGUAGE_MODE": "multilanguage",
    "OVS_WORKER_IO_QUEUE_WHEN_SATURATED": "0",
    "ASR_BACKEND": "trt_edgellm",
    "TTS_BACKEND": "trt_edgellm",
    "LAZY_TTS": "1",
    "EDGE_LLM_ASR_WORKER": "1",
    "EDGE_LLM_ASR_STREAM_MODE": "worker",
    "EDGELLM_REQUEST_AUDIO_WAV": "1",
    "EDGE_LLM_ASR_MAX_CONCURRENT": "2",
    "EDGE_LLM_ASR_WORKER_BIN": "/opt/edgellm-v091/bin/qwen3_asr_worker",
    "EDGE_LLM_ASR_ENGINE_DIR": "/opt/edgellm-v091/engines/asr_thinker_full_int4_b2",
    "EDGE_LLM_ASR_AUDIO_ENC_DIR": "/opt/edgellm-v091/engines/asr_audio_encoder",
    "EDGE_LLM_TTS_WORKER": "1",
    "EDGE_LLM_TTS_WORKER_BIN": "/opt/edgellm-v091/bin/qwen3_tts_streaming_worker",
    "EDGELLM_PLUGIN_PATH": "/opt/edgellm-v091/libNvInfer_edgellm_plugin.so",
    "EDGE_LLM_TTS_TALKER_DIR": "/opt/edgellm-v091/engines/tts_customvoice_int4/talker",
    "EDGE_LLM_TTS_CP_DIR": "/opt/edgellm-v091/engines/tts_customvoice_fp16/code_predictor",
    "EDGE_LLM_TTS_CODE2WAV_DIR": "/opt/edgellm-v091/engines/tts_customvoice_fp16/code2wav/code2wav",
    "EDGE_LLM_TTS_TOKENIZER_DIR": "/opt/edgellm-v091/engines/tts_customvoice_int4/talker",
    "EDGE_LLM_TTS_STATEFUL_CODE2WAV": "0",
    "EDGE_LLM_TTS_STREAMING_ONLY": "1",
    "OVS_TTS_WORKER_CONCURRENCY": "1",
    "OVS_TTS_SAMPLE_RATE": "24000",
    "OVS_TTS_CHANNELS": "1",
    "OVS_TTS_SEED": "42"
  },
  "tts_worker_concurrency": 1,
  "profile_owned_env": [
    "EDGE_LLM_ASR_WORKER_BIN",
    "EDGE_LLM_ASR_ENGINE_DIR",
    "EDGE_LLM_ASR_AUDIO_ENC_DIR",
    "EDGE_LLM_TTS_WORKER_BIN",
    "EDGELLM_PLUGIN_PATH",
    "EDGE_LLM_TTS_TALKER_DIR",
    "EDGE_LLM_TTS_CP_DIR",
    "EDGE_LLM_TTS_CODE2WAV_DIR",
    "EDGE_LLM_TTS_TOKENIZER_DIR"
  ],
  "required_engines": [
    {"model_id": "qwen3-asr-0.6b", "engine_file": "llm.engine", "engine_path": "/opt/edgellm-v091/engines/asr_thinker_full_int4_b2/llm.engine", "env_var": "EDGE_LLM_ASR_ENGINE_FILE", "required": true},
    {"model_id": "qwen3-asr-0.6b", "engine_file": "audio_encoder.engine", "engine_path": "/opt/edgellm-v091/engines/asr_audio_encoder/audio/audio_encoder.engine", "env_var": "EDGE_LLM_ASR_AUDIO_ENGINE_FILE", "required": true},
    {"model_id": "qwen3-tts-customvoice", "engine_file": "llm.engine", "engine_path": "/opt/edgellm-v091/engines/tts_customvoice_int4/talker/llm.engine", "env_var": "EDGE_LLM_TTS_TALKER_ENGINE_FILE", "required": true},
    {"model_id": "qwen3-tts-customvoice", "engine_file": "llm.engine", "engine_path": "/opt/edgellm-v091/engines/tts_customvoice_fp16/code_predictor/llm.engine", "env_var": "EDGE_LLM_TTS_CP_ENGINE_FILE", "required": true},
    {"model_id": "qwen3-tts-customvoice", "engine_file": "code2wav.engine", "engine_path": "/opt/edgellm-v091/engines/tts_customvoice_fp16/code2wav/code2wav/code2wav.engine", "env_var": "EDGE_LLM_TTS_CODE2WAV_ENGINE_FILE", "required": true}
  ]
}
