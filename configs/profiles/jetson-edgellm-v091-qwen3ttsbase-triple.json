{
  "name": "jetson-edgellm-v091-qwen3ttsbase-triple",
  "description": "Opt-in Orin NX profile for one Qwen3-ASR request plus one Qwen3-TTS Base request while Qwen3.5-4B GDN remains active. Device-qualified with low-latency 7/10 streaming chunks: strict triple-load Base TTFA is about 0.9-1.0 seconds. MOSS remains the lower-latency triple option.",
  "asr_backend": "jetson.trt_edge_llm",
  "asr_model_id": "qwen3-asr",
  "tts_backend": "jetson.trt_edge_llm",
  "tts_model_id": "qwen3-tts-0.6b-base",
  "artifact_set": "edgellm-v091",
  "execution_policy": {
    "mode": "concurrent",
    "shared_resource": "gpu",
    "cross_modal_overlap": true
  },
  "env": {
    "LANGUAGE_MODE": "multilanguage",
    "OVS_WORKER_IO_QUEUE_WHEN_SATURATED": "0",
    "ASR_BACKEND": "trt_edgellm",
    "TTS_BACKEND": "trt_edgellm",
    "LAZY_TTS": "0",
    "EDGE_LLM_ASR_WORKER": "1",
    "EDGE_LLM_ASR_STREAM_MODE": "worker",
    "EDGELLM_REQUEST_AUDIO_WAV": "1",
    "EDGE_LLM_ASR_WORKER_BIN": "/opt/edgellm-v091/bin/qwen3_asr_worker",
    "EDGE_LLM_ASR_ENGINE_DIR": "/opt/edgellm-v091/engines/asr_thinker_full_int4_b1",
    "EDGE_LLM_ASR_AUDIO_ENC_DIR": "/opt/edgellm-v091/engines/asr_audio_encoder",
    "EDGE_LLM_TTS_WORKER": "1",
    "EDGE_LLM_TTS_WORKER_BIN": "/opt/edgellm-v091/bin/qwen3_tts_streaming_worker",
    "EDGELLM_PLUGIN_PATH": "/opt/edgellm-v091/libNvInfer_edgellm_plugin.so",
    "EDGE_LLM_TTS_TALKER_DIR": "/opt/edgellm-v091/engines/tts_base_talker_b1_kv1536",
    "EDGE_LLM_TTS_CP_DIR": "/opt/edgellm-v091/engines/tts_base_code_predictor_b1_kv1536",
    "EDGE_LLM_TTS_CODE2WAV_DIR": "/opt/edgellm-v091/engines/tts_base_code2wav_512",
    "EDGE_LLM_TTS_TOKENIZER_DIR": "/opt/edgellm-v091/engines/tts_base_talker_b1_kv1536",
    "EDGE_LLM_TTS_BASE_SPK_EMBED_PATH": "/opt/edgellm-v091/models/qwen3-tts-base/ref_embedding.b64.txt",
    "EDGE_LLM_TTS_STATEFUL_CODE2WAV": "0",
    "EDGE_LLM_TTS_STREAMING_ONLY": "1",
    "EDGE_LLM_TTS_STREAMING_PROFILE": "low_latency",
    "EDGE_LLM_TTS_FIRST_CHUNK_FRAMES": "7",
    "EDGE_LLM_TTS_CHUNK_FRAMES": "10",
    "EDGE_LLM_TTS_ADAPTIVE_CHUNKS": "0",
    "EDGE_LLM_TTS_MAX_CHUNK_FRAMES": "10",
    "EDGE_LLM_TTS_CHUNK_GROWTH_FRAMES": "0",
    "TTS_MAX_AUDIO_LENGTH": "512",
    "OVS_TTS_WORKER_CONCURRENCY": "1",
    "OVS_TTS_SAMPLE_RATE": "24000",
    "OVS_TTS_CHANNELS": "1"
  },
  "tts_worker_concurrency": 1,
  "max_concurrent_sessions": 2,
  "required_engines": [
    {"model_id": "qwen3-asr-0.6b", "engine_file": "llm.engine", "engine_path": "/opt/edgellm-v091/engines/asr_thinker_full_int4_b1/llm.engine", "env_var": "EDGE_LLM_ASR_ENGINE_FILE", "required": true},
    {"model_id": "qwen3-tts-0.6b-base", "engine_file": "llm.engine", "engine_path": "/opt/edgellm-v091/engines/tts_base_talker_b1_kv1536/llm.engine", "env_var": "EDGE_LLM_TTS_TALKER_ENGINE_FILE", "required": true},
    {"model_id": "qwen3-tts-0.6b-base", "engine_file": "llm.engine", "engine_path": "/opt/edgellm-v091/engines/tts_base_code_predictor_b1_kv1536/llm.engine", "env_var": "EDGE_LLM_TTS_CP_ENGINE_FILE", "required": true},
    {"model_id": "qwen3-tts-0.6b-base", "engine_file": "code2wav.engine", "engine_path": "/opt/edgellm-v091/engines/tts_base_code2wav_512/code2wav.engine", "env_var": "EDGE_LLM_TTS_CODE2WAV_ENGINE_FILE", "required": true}
  ]
}
