{
  "name": "jetson-edgellm-v091-matcha",
  "description": "TensorRT-Edge-LLM v0.9.1 Qwen3-ASR plus Matcha zh/en TTS for the Orin NX production voice-agent stack. Qwen3-ASR and Matcha keep one cross-modal request slot each while the separately managed Qwen3.5-4B GDN service remains resident. Matcha uses its split TensorRT estimator and Vocos engines with CPU ONNX text/acoustic sidecars.",
  "asr_backend": "jetson.trt_edge_llm",
  "asr_model_id": "qwen3-asr",
  "tts_backend": "jetson.matcha_trt",
  "tts_model_id": "matcha-icefall-zh-en",
  "artifact_set": "edgellm-v091",
  "execution_policy": {
    "mode": "concurrent",
    "shared_resource": "gpu",
    "cross_modal_overlap": true
  },
  "env": {
    "LANGUAGE_MODE": "multilanguage",
    "OVS_WORKER_IO_QUEUE_WHEN_SATURATED": "0",
    "ASR_BACKEND": "trt_edgellm",
    "TTS_BACKEND": "matcha_trt",
    "LAZY_TTS": "0",
    "EDGE_LLM_ASR_WORKER": "1",
    "EDGE_LLM_ASR_STREAM_MODE": "worker",
    "EDGELLM_REQUEST_AUDIO_WAV": "1",
    "EDGE_LLM_ASR_WORKER_BIN": "/opt/edgellm-v091/bin/qwen3_asr_worker",
    "EDGE_LLM_ASR_ENGINE_DIR": "/opt/edgellm-v091/engines/asr_thinker_full_int4_b1",
    "EDGE_LLM_ASR_AUDIO_ENC_DIR": "/opt/edgellm-v091/engines/asr_audio_encoder",
    "EDGELLM_PLUGIN_PATH": "/opt/edgellm-v091/libNvInfer_edgellm_plugin.so",
    "MATCHA_MODEL_BASE": "/opt/models/matcha-icefall-zh-en",
    "MATCHA_ACOUSTIC_EP": "SPLIT_TRT",
    "MATCHA_SPLIT_ENCODER_ONNX": "/opt/models/matcha-icefall-zh-en/onnx/matcha_encoder_trt.onnx",
    "MATCHA_SPLIT_ESTIMATOR_ENGINE": "/opt/models/matcha-icefall-zh-en/engines/matcha_estimator_step0_bf16.engine",
    "VOCOS_ENGINE": "/opt/models/matcha-icefall-zh-en/engines/vocos_fp16.engine",
    "OVS_TTS_SAMPLE_RATE": "22050",
    "OVS_TTS_CHANNELS": "1",
    "OVS_TTS_LOW_LATENCY_CJK_MIN_CHARS": "15",
    "OVS_TTS_LOW_LATENCY_CJK_TARGET_CHARS": "24",
    "OVS_TTS_LOW_LATENCY_CJK_MAX_CHARS": "40",
    "OVS_TTS_LOW_LATENCY_LATIN_MIN_CHARS": "40",
    "OVS_TTS_LOW_LATENCY_LATIN_TARGET_CHARS": "60",
    "OVS_TTS_LOW_LATENCY_LATIN_MAX_CHARS": "120"
  },
  "max_concurrent_sessions": 2,
  "required_engines": [
    {
      "model_id": "qwen3-asr-0.6b",
      "engine_file": "llm.engine",
      "engine_path": "/opt/edgellm-v091/engines/asr_thinker_full_int4_b1/llm.engine",
      "env_var": "EDGE_LLM_ASR_ENGINE_FILE",
      "required": true
    },
    {
      "model_id": "matcha-icefall-zh-en",
      "engine_file": "vocos_fp16.engine",
      "engine_path": "/opt/models/matcha-icefall-zh-en/engines/vocos_fp16.engine",
      "env_var": "VOCOS_ENGINE",
      "required": true
    },
    {
      "model_id": "matcha-icefall-zh-en",
      "engine_file": "matcha_estimator_step0_bf16.engine",
      "engine_path": "/opt/models/matcha-icefall-zh-en/engines/matcha_estimator_step0_bf16.engine",
      "env_var": "MATCHA_SPLIT_ESTIMATOR_ENGINE",
      "required": true
    }
  ]
}
