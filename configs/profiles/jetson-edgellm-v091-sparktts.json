{
  "name": "jetson-edgellm-v091-sparktts",
  "description": "TensorRT-Edge-LLM v0.9.1 SparkTTS service profile for Jetson Orin NX. W4A16 is the default LLM; the v0.9.1 native worker, plugin, LLM/tokenizer, BiCodec and speaker decoder all come from the versioned /opt/edgellm-v091 artifact mount. N=2 is an explicit TTS-only capacity mode and is not a multi-model co-residency claim.",
  "asr_backend": null,
  "tts_backend": "jetson.sparktts",
  "tts_model_id": "sparktts-0p5b",
  "artifact_set": "edgellm-v091",
  "model_artifacts": [
    {
      "model_id": "sparktts-0p5b",
      "repo": "harvestsu/sparktts-0p5b-jetson-artifacts",
      "revision": "5b4d6b3e9a42557dee2f6ec8a815aad5948d0cc1",
      "canonical_model_id": "sparktts-0.5b",
      "root": "/opt/models/sparktts-0.5b",
      "required_files": [
        "engines/sparktts-w4a16",
        "engines/sparktts-shared/bicodec_decoder_dynT.fp16.engine",
        "engines/sparktts-shared/sparktts_speaker_decoder.fp32.engine"
      ]
    }
  ],
  "deployment_scope": "isolated-sparktts-n2",
  "execution_policy": {
    "mode": "concurrent",
    "shared_resource": "gpu"
  },
  "tts_worker_concurrency": 2,
  "sparktts_worker_concurrency": 2,
  "max_concurrent_sessions": 2,
  "tts_sample_rate": 16000,
  "env": {
    "LANGUAGE_MODE": "multilanguage",
    "TTS_BACKEND": "jetson.sparktts",
    "OVS_TTS_MODEL_ID": "sparktts-0p5b",
    "OVS_TTS_SAMPLE_RATE": "16000",
    "OVS_TTS_CHANNELS": "1",
    "OVS_TTS_WORKER_CONCURRENCY": "2",
    "OVS_MAX_CONCURRENT_SESSIONS": "2",
    "EDGELLM_PLUGIN_PATH": "/opt/edgellm-v091/libNvInfer_edgellm_plugin.so",
    "SPARKTTS_WORKER_BINARY": "/opt/edgellm-v091/bin/spark_tts_worker",
    "SPARKTTS_PLUGIN_PATH": "/opt/edgellm-v091/libNvInfer_edgellm_plugin.so",
    "SPARKTTS_LLM_ENGINE_DIR": "/opt/models/sparktts-0.5b/engines/sparktts-w4a16",
    "SPARKTTS_TOKENIZER_DIR": "/opt/models/sparktts-0.5b/engines/sparktts-w4a16",
    "SPARKTTS_BICODEC_ENGINE": "/opt/models/sparktts-0.5b/engines/sparktts-shared/bicodec_decoder_dynT.fp16.engine",
    "SPARKTTS_SPEAKER_DECODER_ENGINE": "/opt/models/sparktts-0.5b/engines/sparktts-shared/sparktts_speaker_decoder.fp32.engine",
    "SPARKTTS_VOICES_DIR": "/opt/seeed-local-voice/data/sparktts_voices",
    "SPARKTTS_SAMPLE_RATE": "16000",
    "SPARKTTS_FIRST_CHUNK_TOKENS": "6",
    "SPARKTTS_CHUNK_TOKENS": "16",
    "SPARKTTS_LEFT_OVERLAP_TOKENS": "12",
    "SPARKTTS_MAX_TOKENS": "800",
    "SPARKTTS_MAX_SEMANTIC": "600",
    "SPARKTTS_DEFAULT_GENDER": "female",
    "SPARKTTS_DEFAULT_PITCH": "moderate",
    "SPARKTTS_DEFAULT_SPEED": "moderate"
  },
  "required_engines": [
    {
      "model_id": "sparktts-0p5b-w4a16",
      "engine_file": "llm.engine",
      "engine_path": "/opt/models/sparktts-0.5b/engines/sparktts-w4a16/llm.engine",
      "env_var": "SPARKTTS_LLM_ENGINE_DIR",
      "env_path": "/opt/models/sparktts-0.5b/engines/sparktts-w4a16",
      "extra_files": [
        "sparktts-w4a16/tokenizer.json",
        "sparktts-w4a16/tokenizer_config.json",
        "sparktts-w4a16/config.json",
        "sparktts-w4a16/embedding.safetensors",
        "sparktts-w4a16/processed_chat_template.json",
        "sparktts-w4a16/token-gate.json",
        "sparktts-w4a16/DRIVER_REVISION",
        "sparktts-w4a16/PROVENANCE.md"
      ],
      "required": true
    },
    {
      "model_id": "sparktts-0p5b-shared",
      "engine_file": "bicodec_decoder_dynT.fp16.engine",
      "engine_path": "/opt/models/sparktts-0.5b/engines/sparktts-shared/bicodec_decoder_dynT.fp16.engine",
      "env_var": "SPARKTTS_BICODEC_ENGINE",
      "required": true
    },
    {
      "model_id": "sparktts-0p5b-shared",
      "engine_file": "sparktts_speaker_decoder.fp32.engine",
      "engine_path": "/opt/models/sparktts-0.5b/engines/sparktts-shared/sparktts_speaker_decoder.fp32.engine",
      "env_var": "SPARKTTS_SPEAKER_DECODER_ENGINE",
      "required": true
    }
  ]
}
